# The build-machine profile of the Rocky Linux 8 CI image (docker/Dockerfile.rocky8),
# and the host profile of its desktop builds.
[settings]
arch=x86_64
build_type=Release
compiler=gcc
compiler.cppstd=gnu23
compiler.libcxx=libstdc++11
compiler.version=15
os=Linux

[conf]
tools.compilation:verbosity=verbose
tools.build:cxxflags=["-fcoroutines"]
# GCC 15 is gcc-toolset-15, which the image puts first on PATH; the distribution's own
# GCC is 8.5. Naming the compilers keeps a build on the toolset even if a later
# package brings in /usr/bin/cc, which CMake would otherwise try first.
tools.build:compiler_executables={"c": "gcc", "cpp": "g++"}
# See the same line in profiles/ubuntu2404.
tools.cmake.cmaketoolchain:user_presets=
